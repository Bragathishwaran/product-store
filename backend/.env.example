# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
DEBUG=false

# --- Database --------------------------------------------------------------
# SQLite is the default for easy local development.
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/ecommerce
# MySQL:      mysql+pymysql://user:password@localhost:3306/ecommerce
DATABASE_URL=sqlite:///./app.db
SQL_ECHO=false

# --- JWT -------------------------------------------------------------------
JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Stripe (test mode) ----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_CURRENCY=inr

# Where the browser is sent after Stripe Checkout
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancel

# --- Tests (optional) ------------------------------------------------------
# TEST_DATABASE_URL=sqlite:///./test.db
